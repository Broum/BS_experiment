# Copy to .env (gitignored) and fill in. Read by the notebooks via python-dotenv; also `source .env` works.
export VLQ_PROJECT=OPEN-37-13
# LEXIS resource of the VLQ machine; empty -> qaas picks the project's default resource.
export VLQ_RESOURCE=VLQ-CZ
# Optional LEXIS access token (starts with eyJ). Empty -> interactive LexisSession login.
export VLQ_TOKEN=
# IQM Resonance token for Sirius. Alternatively put it alone in the file .IQM_token (gitignored).
export IQM_TOKEN=
